# === Frappe / ERPNext backend ===
# Leave VITE_FRAPPE_URL EMPTY for Vite dev so the SDK calls same-origin /api
# (Vite proxies to ERPNext). If set to http://localhost:8080 the browser talks
# cross-origin and session cookies will not attach correctly.
VITE_FRAPPE_URL=

# Where Vite's server.proxy forwards /api, /files, /socket.io (see vite.config.ts).
# Not exposed to the browser bundle — only used by the Node proxy.
VITE_PROXY_TARGET=http://localhost:8080

# Optional — enables the realtime/Socket.IO WebSocket for live updates.
VITE_ENABLE_SOCKET=true

# Frappe multi-site name (docker SITE_NAME=frontend). Sent as Host header by the proxy.
VITE_FRAPPE_SITE=frontend
